#!/usr/bin/env bash

set -euo pipefail
shopt -s nullglob
# Remember the user's locale before forcing C for predictable parsing.
readonly user_locale=${LC_ALL:-${LC_CTYPE:-${LANG:-}}}
export LC_ALL=C
# Saved bans are world-readable so that list works without root.
umask 022

readonly config=/etc/nfban
readonly hosts=$config/hosts
readonly cidrs=$config/cidrs.txt
readonly unit=/etc/systemd/system/nfban.service
readonly nft_table='inet nfban'
readonly ipv4='([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})'
readonly address_pattern="^${ipv4}(/([0-9]{1,2}))?$"
readonly ip_key='
function key(address, octet) {
  split(address, octet, /[.\/]/)
  return ((octet[1]*256 + octet[2])*256 + octet[3])*256 + octet[4]
}'

temp=
framed=
cleanup() {
  if [[ -n $temp ]]; then rm -f -- "$temp"; fi
  # Close the blank-line frame around terminal output.
  if [[ -n $framed ]]; then printf '\n' >&"$framed"; fi
}
trap cleanup EXIT

sudo_prefix=
if ((EUID != 0)) || [[ ${SUDO_UID:-0} != 0 ]]; then
  if command -v sudo >/dev/null; then
    sudo_prefix='sudo '
  fi
fi
readonly sudo_prefix

# Colors only on terminals, honoring NO_COLOR (https://no-color.org).
colors_for() {
  [[ -t $1 && -z ${NO_COLOR-} && ${TERM-dumb} != dumb ]]
}
bold='' dim='' red='' green='' reset=''
if colors_for 1; then
  bold=$'\e[1m' dim=$'\e[2m' red=$'\e[31m' green=$'\e[32m' reset=$'\e[0m'
fi
err_bold='' err_dim='' err_red='' err_reset=''
if colors_for 2; then
  err_bold=$'\e[1m' err_dim=$'\e[2m' err_red=$'\e[31m' err_reset=$'\e[0m'
fi
readonly bold dim red green reset err_bold err_dim err_red err_reset
readonly awk_error="${err_bold}${err_red}error:${err_reset} "
case $user_locale in
  *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) sym_ok='✓' sym_fail='✗' sym_dot='●' ;;
  *) sym_ok='+' sym_fail='x' sym_dot='*' ;;
esac
readonly sym_ok sym_fail sym_dot

heading() {
  printf '%s%s%s\n' "$bold" "$1" "$reset"
}

success() {
  printf '%s%s%s %s\n' "$green" "$sym_ok" "$reset" "$1"
}

hint() {
  printf '  %s%s%s %s\n' "$dim" "$1" "$reset" "$2"
}

command_help() {
  local example
  heading Usage
  printf '  %s\n\n%s\n\n' "$1" "$2"
  heading Examples
  for example in "${@:3}"; do
    printf '  %s%s\n' "$sudo_prefix" "$example"
  done
}

command_row() {
  printf '  %s%-22s%s  %s\n' "$bold" "$1" "$reset" "$2"
}

usage() {
  case ${1-} in
    init)
      command_help 'nfban init' \
        'Installs missing packages via apt-get, creates storage and enables
nfban.service without starting it.' \
        'nfban init'
      ;;
    reload)
      command_help 'nfban reload' \
        'Atomically switches to a new copy of the bans loaded in batches.' \
        'nfban reload'
      ;;
    add)
      command_help 'nfban add <IPv4|CIDR>' \
        'Bans an address or subnet live and saves it.' \
        'nfban add 192.0.2.10' 'nfban add 198.51.100.0/24'
      ;;
    remove)
      command_help 'nfban <remove|rm> <IPv4|CIDR>' \
        'Removes only the exact ban, not any covering subnet.' \
        'nfban rm 192.0.2.10' 'nfban rm 192.0.2.0/24'
      ;;
    list)
      command_help 'nfban list' \
        'Lists saved bans in numeric order, one per line.' \
        'nfban list' 'nfban list | wc -l'
      ;;
    status)
      command_help 'nfban status' \
        'Shows ban counts and live availability.
Prints key=value lines when stdout is not a terminal.' \
        'nfban status'
      ;;
    *)
      printf '%s\n\n' 'Manage permanent IPv4 bans in nftables.'
      heading Usage
      printf '  %s\n\n' 'nfban <command> [argument]'
      heading Commands
      command_row 'init' 'Install packages, create storage, enable nfban.service'
      command_row 'reload' 'Atomically reload saved bans'
      command_row 'add <IPv4|CIDR>' 'Ban an address or subnet'
      command_row 'remove, rm <IPv4|CIDR>' 'Remove an exact ban'
      command_row 'list' 'Print saved bans in numeric order'
      command_row 'status' 'Show ban counts and live rule state'
      printf '\n'
      heading Examples
      printf '  %s%s\n' "$sudo_prefix" 'nfban add 192.0.2.10' \
        "$sudo_prefix" 'nfban add 198.51.100.0/24' "$sudo_prefix" 'nfban status'
      printf '\n%s%s%s\n' "$dim" "Run 'nfban <command> --help' for details." "$reset"
      ;;
  esac
}

# die MESSAGE [COMMAND]: report an error and optionally a command to run next.
die() {
  if [[ -z $framed && -t 2 ]]; then
    printf '\n' >&2
    framed=2
  fi
  printf '%serror:%s %s\n' "$err_bold$err_red" "$err_reset" "$1" >&2
  if (($# > 1)); then
    printf '  %sRun:%s %s\n' "$err_dim" "$err_reset" "$2" >&2
  fi
  exit 1
}

require() {
  command -v "$1" >/dev/null || die "missing required command: $1"
}

# Installs the packages providing missing commands (Debian/Ubuntu only).
install_packages() {
  local packages=()
  command -v nft >/dev/null || packages+=(nftables)
  command -v flock >/dev/null || packages+=(util-linux)
  ((${#packages[@]})) || return 0
  command -v apt-get >/dev/null \
    || die "missing packages: ${packages[*]}; install them and rerun nfban init"
  printf 'Installing %s\n' "${packages[*]}"
  export DEBIAN_FRONTEND=noninteractive
  if ! apt-get -q update || ! apt-get -q install -y --no-install-recommends "${packages[@]}"; then
    die "could not install: ${packages[*]}"
  fi
  # nftables.service loads /etc/nftables.conf, which usually starts with
  # 'flush ruleset' and would wipe ufw, Docker and fail2ban rules.
  if [[ ${packages[0]} == nftables ]] && systemctl -q is-enabled nftables.service 2>/dev/null; then
    printf '%swarning:%s %s\n' "$err_bold" "$err_reset" \
      'nftables.service is enabled; at boot it may flush other firewall rules' >&2
    printf '  %sRun:%s %s\n' "$err_dim" "$err_reset" "${sudo_prefix}systemctl disable nftables" >&2
  fi
}

# lock [shared]: list takes a shared lock through a read-only descriptor,
# so it works without root.
lock() {
  if [[ ${1-} == shared ]]; then
    { exec 9<"$config/nfban.lock"; } 2>/dev/null \
      || die "cannot open $config/nfban.lock" "${sudo_prefix}nfban init"
    flock -s 9
  else
    exec 9>>"$config/nfban.lock"
    flock -x 9
  fi
}

parse_address() {
  local a b c d
  [[ $1 =~ $address_pattern ]] || return 1
  a=$((10#${BASH_REMATCH[1]})) b=$((10#${BASH_REMATCH[2]}))
  c=$((10#${BASH_REMATCH[3]})) d=$((10#${BASH_REMATCH[4]}))
  prefix=$((10#${BASH_REMATCH[6]:-32}))
  ((a <= 255 && b <= 255 && c <= 255 && d <= 255 && prefix <= 32)) || return 1
  network=$(((a << 24 | b << 16 | c << 8 | d) >> (32 - prefix) << (32 - prefix)))
  printf -v address '%d.%d.%d.%d' "$((network >> 24))" "$((network >> 16 & 255))" \
    "$((network >> 8 & 255))" "$((network & 255))"
  if ((prefix < 32)); then
    address+=/$prefix
  fi
}

# Before=network-online.target: services waiting for the network (angie,
# docker) start only after the bans are loaded, while the network itself
# comes up in parallel.
write_unit() {
  cat <<UNIT
[Unit]
Description=Load permanent IPv4 bans
After=nftables.service
Before=network-online.target
PartOf=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$1 reload
ExecReload=$1 reload

[Install]
WantedBy=multi-user.target
UNIT
}

# The unit runs the script as root at boot, so nobody else may be able to
# replace it or any directory above it.
check_script_owner() {
  local path=$1 owner mode
  while
    read -r owner mode <<<"$(stat -c '%u %a' -- "$path")"
    ((owner == 0 && ! (8#$mode & 8#022))) \
      || die "$path must be owned by root and writable only by root"
    [[ $path != / ]]
  do
    path=${path%/*}
    path=${path:-/}
  done
}

init() {
  local script tables
  require systemctl
  script=$(realpath -- "${BASH_SOURCE[0]}")
  [[ -x $script && $script =~ ^/[[:alnum:]_./-]+$ ]] \
    || die 'install nfban as an executable at a stable path (e.g. /usr/local/sbin/nfban)'
  check_script_owner "$script"
  mkdir -p -- "$config"
  lock
  if [[ -e $config/bans || -e $config/blocked.nft || -e $config/table.nft ]]; then
    die "old storage found in $config; export the bans and set up a clean installation"
  fi
  if [[ -e $unit || -L $unit ]]; then
    # Older versions of nfban wrote a unit for the same script; replace it.
    if ! [[ -f $unit && ! -L $unit ]] || ! grep -Fxq -- "ExecStart=$script reload" "$unit"; then
      die "unexpected contents in $unit; refusing to overwrite it"
    fi
  else
    tables=$(nft list tables)
    if grep -Fxq "table $nft_table" <<<"$tables"; then
      die "table $nft_table already exists; refusing to take it over"
    fi
  fi
  mkdir -p -- "$hosts"
  # Older versions created the storage readable by root only.
  chmod -R u=rwX,go=rX -- "$config"
  if [[ ! -e $cidrs ]]; then
    (
      set -o noclobber
      : >"$cidrs"
    )
  fi
  if ! write_unit "$script" | cmp -s -- - "$unit"; then
    mkdir -p -- "${unit%/*}"
    write_unit "$script" >"$unit"
  fi
  systemctl enable nfban.service
  success "Enabled ${bold}nfban.service${reset}"
  hint 'Start it now:' "${sudo_prefix}systemctl start nfban"
}

read_hosts() {
  local files=("$hosts"/[0-9][0-9][0-9].[0-9][0-9][0-9].txt)
  if ((${#files[@]})); then
    # Zero-padded filenames give numeric order; xargs bounds argv size.
    printf '%s\0' "${files[@]}" | xargs -0 cat --
  fi
}

list_bans() {
  if [[ ! -s $cidrs ]]; then
    read_hosts
    return
  fi
  read_hosts | awk -v cidrs="$cidrs" "$ip_key"'
    function advance() {
      available = (getline next_cidr < cidrs)
      if (available < 0) { failed = 1; exit 1 }
      if (available) next_key = key(next_cidr)
    }
    BEGIN { advance() }
    {
      host_key = key($0)
      while (available && next_key < host_key) { print next_cidr; advance() }
      print
    }
    END { if (!failed) while (available) { print next_cidr; advance() } }
  '
}

active_suffix() {
  local chain rules
  # Versions before the prerouting chain dropped bans in the input chain.
  for chain in prerouting input; do
    rules=$(nft -n list chain inet nfban "$chain" 2>/dev/null) || continue
    case $rules in
      *'@blocked_next drop'*) printf '%s' '_next' ;;
      *'@blocked drop'*) ;;
      *) return 1 ;;
    esac
    return
  done
  return 1
}

load_batches() {
  local name=$1 batch
  awk -v name="$name" -v table="$nft_table" -v error="$awk_error" "$ip_key"'
    function invalid() {
      print error "invalid or out-of-order saved entry: " $0 > "/dev/stderr"
      failed = 1
      exit 1
    }
    {
      fields = split($0, a, /[.\/]/)
      is_cidr = name ~ /^blocked_cidrs/
      if (fields != (is_cidr ? 5 : 4)) invalid()
      for (i = 1; i <= fields; ++i)
        if (a[i] !~ /^(0|[1-9][0-9]*)$/ || a[i] > (i == 5 ? 31 : 255)) invalid()
      value = key($0)
      width = is_cidr ? 2^(32-a[5]) : 1
      if (value % width || (NR > 1 && value < end)) invalid()
      end = value + width
      if ((NR-1) % 4096 == 0) printf "add element %s %s { ", table, name
      else printf ", "
      printf "%s", $0
      if (NR % 4096 == 0) print " }"
    }
    END { if (!failed && NR % 4096) print " }" }
  ' | while IFS= read -r batch; do
    nft -f - <<<"$batch" || return 1
  done
}

discard_sets() {
  nft -f - <<NFT
destroy set $nft_table blocked$1
destroy set $nft_table blocked_cidrs$1
NFT
}

reload() {
  local active next=_next legacy='' chain
  if active=$(active_suffix) && [[ -n $active ]]; then
    next=
  fi
  for chain in input forward; do
    if nft list chain inet nfban "$chain" >/dev/null 2>&1; then
      legacy+="flush chain $nft_table $chain"$'\n'"delete chain $nft_table $chain"$'\n'
    fi
  done
  nft -f - <<NFT
add table $nft_table
destroy set $nft_table blocked$next
destroy set $nft_table blocked_cidrs$next
add set $nft_table blocked$next { type ipv4_addr; }
add set $nft_table blocked_cidrs$next { type ipv4_addr; flags interval; }
NFT
  if ! read_hosts | load_batches "blocked$next" \
    || ! load_batches "blocked_cidrs$next" <"$cidrs"; then
    discard_sets "$next" || :
    die 'batch load failed; previous rules were left in place'
  fi
  # Rules and set references change in the same kernel transaction. Priority
  # raw drops banned packets before conntrack, so they create no state.
  if ! nft -f - <<NFT
add chain $nft_table prerouting { type filter hook prerouting priority raw; policy accept; }
flush chain $nft_table prerouting
add rule $nft_table prerouting ip saddr @blocked$next drop
add rule $nft_table prerouting ip saddr @blocked_cidrs$next drop
${legacy}destroy set $nft_table blocked$active
destroy set $nft_table blocked_cidrs$active
NFT
  then
    discard_sets "$next" || :
    die 'could not switch sets; previous rules were left in place'
  fi
  success "Reloaded ${bold}$nft_table${reset}"
}

update_element() {
  local action=$1 set_name=$2 value=$3 error
  if [[ $action == add ]]; then
    nft add element inet nfban "$set_name" "{ $value }"
  elif ! error=$(nft destroy element inet nfban "$set_name" "{ $value }" 2>&1); then
    # nft may reject a missing exact CIDR before its idempotent destroy reaches the kernel.
    if [[ $set_name != blocked_cidrs* || $error != 'Error: element does not exist'$'\n'* ]]; then
      printf '%s\n' "$error" >&2
      return 1
    fi
  fi
}

insert_ban() {
  awk -v address="$address" -v target="$network" -v prefix="$prefix" -v error="$awk_error" \
    "$ip_key"'
    !inserted || prefix < 32 {
      current = key($0)
      if (prefix < 32) {
        split($0, fields, "/")
        if (current < target + 2^(32-prefix) && target < current + 2^(32-fields[2])) {
          print error "CIDR overlaps saved " $0 > "/dev/stderr"
          conflict = 1
          exit 1
        }
      }
      if (!inserted && current > target) { print address; inserted = 1 }
    }
    { print }
    END { if (!inserted && !conflict) print address }
  ' "$1"
}

change_ban() {
  local action=$1 file source active set_name saved
  active=$(active_suffix) || die 'no active ban rules' "${sudo_prefix}nfban reload"
  if ((prefix == 32)); then
    printf -v file '%s/%03d.%03d.txt' "$hosts" "$((network >> 24))" "$((network >> 16 & 255))"
    set_name=blocked$active
  else
    file=$cidrs
    set_name=blocked_cidrs$active
  fi
  source=$file
  if [[ ! -e $source && ! -L $source ]]; then
    source=/dev/null
  else
    [[ -f $source && ! -L $source ]] || die "not a regular file: $source"
  fi
  if grep -Fxq -- "$address" "$source"; then
    saved=1
  else
    [[ $? == 1 ]] || die "cannot read $source"
    saved=0
  fi

  if [[ $action == add && $saved == 0 || $action == remove && $saved == 1 ]]; then
    temp=$(mktemp -- "$file.XXXXXX")
    chmod 644 -- "$temp"
    if [[ $action == add ]]; then
      insert_ban "$source" >"$temp"
    else
      awk -v address="$address" '$0 != address' "$source" >"$temp"
    fi
    sync -- "$temp"
  fi

  # Even a no-op on disk repairs a missing or extra live element.
  update_element "$action" "$set_name" "$address" \
    || die 'nftables update failed; saved bans were not changed'
  if [[ -n $temp ]]; then
    mv -fT -- "$temp" "$file" \
      || die 'live ban changed but saving failed; retry the command or run nfban reload'
    temp=
    sync -- "${file%/*}"
  fi
  if [[ $action == add && $saved == 1 ]]; then
    success "Already banned: $bold$address$reset"
  elif [[ $action == add ]]; then
    success "Banned $bold$address$reset"
  elif [[ $saved == 1 ]]; then
    success "Removed exact ban $bold$address$reset"
  else
    success "No exact ban for $bold$address$reset"
  fi
}

print_status() {
  local state=$3 color symbol label
  if [[ ! -t 1 ]]; then
    printf 'banned_hosts=%d\nbanned_subnets=%d\nactive=%s\n' "$1" "$2" "$state"
    return
  fi
  case $state in
    available) color=$green symbol=$sym_dot label='active' ;;
    *) color=$red symbol=$sym_fail label='unavailable' ;;
  esac
  printf '  %-16s %s\n' 'Banned hosts' "$1" 'Banned subnets' "$2"
  printf '  %-16s %s%s %s%s\n' 'Live rules' "$color" "$symbol" "$label" "$reset"
  if [[ $state == unavailable ]]; then
    printf '\n'
    hint 'Run:' "${sudo_prefix}nfban reload"
  fi
}

status() {
  local host_count cidr_count active state=available
  host_count=$(read_hosts | wc -l)
  cidr_count=$(wc -l <"$cidrs")
  if ! active=$(active_suffix 2>/dev/null) \
    || ! nft -t list set inet nfban "blocked$active" >/dev/null \
    || ! nft -t list set inet nfban "blocked_cidrs$active" >/dev/null; then
    state=unavailable
  fi
  print_status "$host_count" "$cidr_count" "$state"
  [[ $state == available ]]
}

main() {
  local command=${1-} address prefix network run
  # Frame terminal output with blank lines; cleanup closes the frame.
  if [[ -t 1 ]]; then
    printf '\n'
    framed=1
  fi
  case $command in
    '' | -h | --help)
      usage
      return
      ;;
    rm) command=remove ;;
    init | reload | add | remove | list | status) ;;
    *) die "unknown command: $command" 'nfban --help' ;;
  esac
  shift
  case ${1-} in
    -h | --help)
      usage "$command"
      return
      ;;
  esac
  case $command in
    add | remove)
      (($# == 1)) \
        || die 'expected one IPv4 address or CIDR' "${sudo_prefix}nfban $command 192.0.2.10"
      parse_address "$1" \
        || die "invalid IPv4 address or CIDR: $1" "${sudo_prefix}nfban $command 192.0.2.10"
      ;;
    *) (($# == 0)) || die "nfban $command takes no arguments" "${sudo_prefix}nfban $command" ;;
  esac

  if ((EUID != 0)) && [[ $command != list ]]; then
    if [[ -n $sudo_prefix ]]; then
      printf -v run '%q ' nfban "$command" "$@"
      die 'must run as root' "${sudo_prefix}${run% }"
    fi
    die 'must run as root'
  fi
  if [[ $command == init ]]; then install_packages; fi
  require flock
  if [[ $command != list ]]; then require nft; fi
  if [[ $command == init ]]; then
    init
    return
  fi
  if [[ -e $config && ! (-r $config && -x $config) ]]; then
    die "cannot read $config" "${sudo_prefix}nfban init"
  fi
  [[ -f $unit && -d $hosts && -f $cidrs ]] \
    || die 'nfban is not initialized' "${sudo_prefix}nfban init"
  if [[ $command == list ]]; then lock shared; else lock; fi
  case $command in
    add | remove) change_ban "$command" ;;
    reload) reload ;;
    list) list_bans ;;
    status) status ;;
  esac
}

main "$@"
