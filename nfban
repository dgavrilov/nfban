#!/usr/bin/env bash

set -euo pipefail
shopt -s nullglob
# Remember the user's locale before forcing C for predictable parsing.
readonly user_locale=${LC_ALL:-${LC_CTYPE:-${LANG:-}}}
export LC_ALL=C
# Saved bans are world-readable so that list works without root.
umask 022

readonly config=/etc/nfban
readonly hosts=$config/hosts
readonly cidrs=$config/cidrs.txt
readonly allow=$config/allow.txt
readonly unit=/etc/systemd/system/nfban.service
readonly update_url='https://raw.githubusercontent.com/dgavrilov/nfban/master/nfban'
readonly nft_table='inet nfban'
readonly batch_size=16384
readonly ipv4='([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})'
readonly address_pattern="^${ipv4}(/([0-9]{1,2}))?$"
readonly ip_key='
function key(address, octet) {
  split(address, octet, /[.\/]/)
  return ((octet[1]*256 + octet[2])*256 + octet[3])*256 + octet[4]
}'

temp=
framed=
cleanup() {
  if [[ -n $temp ]]; then rm -rf -- "$temp"; fi
  # Close the blank-line frame around terminal output.
  if [[ -n $framed ]]; then printf '\n' >&"$framed"; fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

sudo_prefix=
if ((EUID != 0)) || [[ ${SUDO_UID:-0} != 0 ]]; then
  if command -v sudo >/dev/null; then
    sudo_prefix='sudo '
  fi
fi
readonly sudo_prefix

# Colors only on terminals, honoring NO_COLOR (https://no-color.org).
colors_for() {
  [[ -t $1 && -z ${NO_COLOR-} && ${TERM-dumb} != dumb ]]
}
bold='' dim='' red='' green='' reset=''
if colors_for 1; then
  bold=$'\e[1m' dim=$'\e[2m' red=$'\e[31m' green=$'\e[32m' reset=$'\e[0m'
fi
err_bold='' err_dim='' err_red='' err_reset=''
if colors_for 2; then
  err_bold=$'\e[1m' err_dim=$'\e[2m' err_red=$'\e[31m' err_reset=$'\e[0m'
fi
readonly bold dim red green reset err_bold err_dim err_red err_reset
readonly awk_error="${err_bold}${err_red}error:${err_reset} "
case $user_locale in
  *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) sym_ok='✓' sym_fail='✗' sym_dot='●' ;;
  *) sym_ok='+' sym_fail='x' sym_dot='*' ;;
esac
readonly sym_ok sym_fail sym_dot

heading() {
  printf '%s%s%s\n' "$bold" "$1" "$reset"
}

success() {
  printf '%s%s%s %s\n' "$green" "$sym_ok" "$reset" "$1"
}

hint() {
  printf '  %s%s%s %s\n' "$dim" "$1" "$reset" "$2"
}

command_help() {
  local example
  heading Usage
  printf '  %s\n\n%s\n\n' "$1" "$2"
  heading Examples
  for example in "${@:3}"; do
    printf '  %s%s\n' "$sudo_prefix" "$example"
  done
}

command_row() {
  printf '  %s%-22s%s  %s\n' "$bold" "$1" "$reset" "$2"
}

usage() {
  case ${1-} in
    init)
      command_help 'nfban init' \
        'Installs missing packages via apt-get, creates storage and enables
nfban.service without starting it.' \
        'nfban init'
      ;;
    reload)
      command_help 'nfban reload' \
        'Atomically switches to a new copy of the bans and the allowlist loaded in
batches.' \
        'nfban reload'
      ;;
    block)
      command_help 'nfban block add <IPv4|CIDR>
  nfban block add --batch
  nfban block <remove|rm> <IPv4|CIDR>
  nfban block <remove|rm> --batch
  nfban block <remove|rm> --dedupe
  nfban block list' \
        'add bans an address or subnet live and saves it; a host inside a saved subnet
is not saved again. add warns when the allowlist overrides the new ban. remove
deletes only the exact ban, not any covering subnet. --dedupe removes saved
hosts already covered by a saved subnet. With --batch, reads one address or
subnet per line from stdin; blank lines and # comments are skipped. Nothing
changes if any line is invalid or a new subnet overlaps another one. list
prints saved bans in numeric order and needs no root.' \
        'nfban block add 192.0.2.10' 'nfban block add 198.51.100.0/24' \
        'nfban block add --batch < bans.txt' 'nfban block rm 192.0.2.10' \
        'nfban block rm --dedupe' 'nfban block list | wc -l'
      ;;
    allow)
      command_help 'nfban allow add <IPv4|CIDR>
  nfban allow add --batch
  nfban allow <remove|rm> <IPv4|CIDR>
  nfban allow <remove|rm> --batch
  nfban allow list' \
        'Allowlisted addresses and subnets are accepted before bans are checked, so
they override bans without changing them. Entries must not overlap each other.
remove deletes only the exact entry. With --batch, reads one address or subnet
per line from stdin; blank lines and # comments are skipped. Nothing changes if
any line is invalid or overlaps another entry. list prints the allowlist in
numeric order and needs no root.' \
        'nfban allow add 192.0.2.10' 'nfban allow add 198.51.100.0/24' \
        'nfban allow add --batch < allow.txt' 'nfban allow rm 192.0.2.10' \
        'nfban allow list'
      ;;
    check)
      command_help 'nfban check <IPv4|CIDR>' \
        'Checks whether an address or subnet is banned by a saved entry and whether
an allowlist entry fully covers it. Exits 0 only if it is blocked: banned and
not allowlisted. Prints key=value lines when stdout is not a terminal.' \
        'nfban check 192.0.2.10' 'nfban check 198.51.100.0/24'
      ;;
    status)
      command_help 'nfban status' \
        'Shows ban and allowlist counts and live availability.
Prints key=value lines when stdout is not a terminal.' \
        'nfban status'
      ;;
    self-update)
      command_help 'nfban self-update' \
        'Downloads the latest version of nfban and replaces the installed script.' \
        'nfban self-update'
      ;;
    *)
      printf '%s\n\n' 'Manage permanent IPv4 bans and an allowlist in nftables.'
      heading Usage
      printf '  %s\n\n' 'nfban <command> [subcommand] [argument]'
      heading Commands
      command_row 'init' 'Install packages, create storage, enable nfban.service'
      command_row 'reload' 'Atomically reload saved bans and the allowlist'
      command_row 'block add <IPv4|CIDR>' 'Ban an address or subnet'
      command_row 'block add --batch' 'Ban addresses and subnets from stdin'
      command_row 'block rm <IPv4|CIDR>' 'Remove an exact ban'
      command_row 'block rm --batch' 'Remove exact bans from stdin'
      command_row 'block rm --dedupe' 'Remove hosts covered by subnets'
      command_row 'block list' 'Print saved bans in numeric order'
      command_row 'allow add <IPv4|CIDR>' 'Allowlist an address or subnet'
      command_row 'allow add --batch' 'Allowlist addresses and subnets from stdin'
      command_row 'allow rm <IPv4|CIDR>' 'Remove an exact allowlist entry'
      command_row 'allow rm --batch' 'Remove exact allowlist entries from stdin'
      command_row 'allow list' 'Print the allowlist in numeric order'
      command_row 'check <IPv4|CIDR>' 'Check if an address or subnet is blocked'
      command_row 'status' 'Show counts and live rule state'
      command_row 'self-update' 'Update nfban to the latest version'
      printf '\n'
      heading Examples
      printf '  %s%s\n' "$sudo_prefix" 'nfban block add 192.0.2.10' \
        "$sudo_prefix" 'nfban allow add 198.51.100.0/24' "$sudo_prefix" 'nfban status'
      printf '\n%s%s%s\n' "$dim" "Run 'nfban <command> --help' for details." "$reset"
      ;;
  esac
}

# die MESSAGE [COMMAND]: report an error and optionally a command to run next.
die() {
  if [[ -z $framed && -t 2 ]]; then
    printf '\n' >&2
    framed=2
  fi
  printf '%serror:%s %s\n' "$err_bold$err_red" "$err_reset" "$1" >&2
  if (($# > 1)); then
    printf '  %sRun:%s %s\n' "$err_dim" "$err_reset" "$2" >&2
  fi
  exit 1
}

warn() {
  printf '%swarning:%s %s\n' "$err_bold" "$err_reset" "$1" >&2
}

require() {
  command -v "$1" >/dev/null || die "missing required command: $1"
}

# Installs the packages providing missing commands (Debian/Ubuntu only).
install_packages() {
  local packages=()
  command -v nft >/dev/null || packages+=(nftables)
  command -v flock >/dev/null || packages+=(util-linux)
  ((${#packages[@]})) || return 0
  command -v apt-get >/dev/null \
    || die "missing packages: ${packages[*]}; install them and rerun nfban init"
  printf 'Installing %s\n' "${packages[*]}"
  export DEBIAN_FRONTEND=noninteractive
  if ! apt-get -q update || ! apt-get -q install -y --no-install-recommends "${packages[@]}"; then
    die "could not install: ${packages[*]}"
  fi
  # nftables.service loads /etc/nftables.conf, which usually starts with
  # 'flush ruleset' and would wipe ufw, Docker and fail2ban rules.
  if [[ ${packages[0]} == nftables ]] && systemctl -q is-enabled nftables.service 2>/dev/null; then
    printf '%swarning:%s %s\n' "$err_bold" "$err_reset" \
      'nftables.service is enabled; at boot it may flush other firewall rules' >&2
    printf '  %sRun:%s %s\n' "$err_dim" "$err_reset" "${sudo_prefix}systemctl disable nftables" >&2
  fi
}

# lock [shared]: list takes a shared lock through a read-only descriptor,
# so it works without root.
lock() {
  if [[ ${1-} == shared ]]; then
    { exec 9<"$config/nfban.lock"; } 2>/dev/null \
      || die "cannot open $config/nfban.lock" "${sudo_prefix}nfban init"
    flock -s 9
  else
    exec 9>>"$config/nfban.lock"
    flock -x 9
  fi
}

parse_address() {
  local a b c d
  [[ $1 =~ $address_pattern ]] || return 1
  a=$((10#${BASH_REMATCH[1]})) b=$((10#${BASH_REMATCH[2]}))
  c=$((10#${BASH_REMATCH[3]})) d=$((10#${BASH_REMATCH[4]}))
  prefix=$((10#${BASH_REMATCH[6]:-32}))
  ((a <= 255 && b <= 255 && c <= 255 && d <= 255 && prefix >= 1 && prefix <= 32)) || return 1
  network=$(((a << 24 | b << 16 | c << 8 | d) >> (32 - prefix) << (32 - prefix)))
  printf -v address '%d.%d.%d.%d' "$((network >> 24))" "$((network >> 16 & 255))" \
    "$((network >> 8 & 255))" "$((network & 255))"
  if ((prefix < 32)); then
    address+=/$prefix
  fi
}

# Before=network-online.target: services waiting for the network (angie,
# docker) start only after the bans are loaded, while the network itself
# comes up in parallel.
write_unit() {
  cat <<UNIT
[Unit]
Description=Load permanent IPv4 bans
After=nftables.service
Before=network-online.target
PartOf=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$1 reload
ExecReload=$1 reload

[Install]
WantedBy=multi-user.target
UNIT
}

# The unit runs the script as root at boot, so nobody else may be able to
# replace it or any directory above it.
check_script_owner() {
  local path=$1 owner mode
  while
    read -r owner mode <<<"$(stat -c '%u %a' -- "$path")"
    ((owner == 0 && ! (8#$mode & 8#022))) \
      || die "$path must be owned by root and writable only by root"
    [[ $path != / ]]
  do
    path=${path%/*}
    path=${path:-/}
  done
}

init() {
  local script tables
  require systemctl
  script=$(realpath -- "${BASH_SOURCE[0]}")
  [[ -x $script && $script =~ ^/[[:alnum:]_./-]+$ ]] \
    || die 'install nfban as an executable at a stable path (e.g. /usr/local/sbin/nfban)'
  check_script_owner "$script"
  mkdir -p -- "$config"
  lock
  if [[ -e $config/bans || -e $config/blocked.nft || -e $config/table.nft ]]; then
    die "old storage found in $config; export the bans and set up a clean installation"
  fi
  if [[ -e $unit || -L $unit ]]; then
    # Older versions of nfban wrote a unit for the same script; replace it.
    if ! [[ -f $unit && ! -L $unit ]] || ! grep -Fxq -- "ExecStart=$script reload" "$unit"; then
      die "unexpected contents in $unit; refusing to overwrite it"
    fi
  else
    tables=$(nft list tables)
    if grep -Fxq "table $nft_table" <<<"$tables"; then
      die "table $nft_table already exists; refusing to take it over"
    fi
  fi
  mkdir -p -- "$hosts"
  # Older versions created the storage readable by root only.
  chmod -R u=rwX,go=rX -- "$config"
  local file
  for file in "$cidrs" "$allow"; do
    if [[ ! -e $file ]]; then
      (
        set -o noclobber
        : >"$file"
      )
    fi
  done
  if ! write_unit "$script" | cmp -s -- - "$unit"; then
    mkdir -p -- "${unit%/*}"
    write_unit "$script" >"$unit"
  fi
  systemctl enable nfban.service
  success "Enabled ${bold}nfban.service${reset}"
  hint 'Start it now:' "${sudo_prefix}systemctl start nfban"
}

read_hosts() {
  local files=("$hosts"/[0-9][0-9][0-9].[0-9][0-9][0-9].txt)
  local i
  # Zero-padded filenames give numeric order; chunking bounds argv size
  # without xargs printing SIGPIPE errors when a consumer exits early.
  for ((i = 0; i < ${#files[@]}; i += 1000)); do
    cat -- "${files[@]:i:1000}" || return
  done
}

# Installs from older versions have no allowlist file until it is needed.
read_allow() {
  if [[ -e $allow ]]; then cat -- "$allow"; fi
}

list_bans() {
  if [[ ! -s $cidrs ]]; then
    read_hosts
    return
  fi
  read_hosts | awk -v cidrs="$cidrs" "$ip_key"'
    function advance() {
      available = (getline next_cidr < cidrs)
      if (available < 0) { failed = 1; exit 1 }
      if (available) next_key = key(next_cidr)
    }
    BEGIN { advance() }
    {
      host_key = key($0)
      while (available && next_key < host_key) { print next_cidr; advance() }
      print
    }
    END { if (!failed) while (available) { print next_cidr; advance() } }
  '
}

active_suffix() {
  local chain rules
  # Versions before the prerouting chain dropped bans in the input chain.
  for chain in prerouting input; do
    rules=$(nft -n list chain inet nfban "$chain" 2>/dev/null) || continue
    case $rules in
      *'@blocked_next drop'*) printf '%s' '_next' ;;
      *'@blocked drop'*) ;;
      *) return 1 ;;
    esac
    return
  done
  return 1
}

load_batches() {
  local name=$1 action=${2:-add}
  awk -v name="$name" -v action="$action" -v table="$nft_table" \
    -v size="$batch_size" -v error="$awk_error" '
    BEGIN {
      # The allowlist mixes hosts and subnets in one interval set.
      mode = name ~ /^blocked_cidrs/ ? "cidr" : name ~ /^allowed/ ? "mixed" : "host"
      cmd = "nft -f -"
    }
    function invalid() {
      print error "invalid or out-of-order saved entry: " $0 > "/dev/stderr"
      failed = 1
      exit 1
    }
    {
      fields = split($0, a, /[.\/]/)
      if (mode == "cidr" ? fields != 5 : mode == "host" ? fields != 4 : fields != 4 && fields != 5) invalid()
      for (i = 1; i <= fields; ++i)
        if (a[i] !~ /^(0|[1-9][0-9]*)$/ || (i == 5 ? (a[i] < 1 || a[i] > 31) : a[i] > 255)) invalid()
      value = ((a[1]*256 + a[2])*256 + a[3])*256 + a[4]
      width = fields == 5 ? 2^(32 - a[5]) : 1
      if (value % width || (NR > 1 && value < end)) invalid()
      end = value + width
      if ((NR - 1) % size == 0) printf "%s element %s %s { ", action, table, name | cmd
      else printf ", " | cmd
      printf "%s", $0 | cmd
      if (NR % size == 0) {
        print " }" | cmd
        if (close(cmd) != 0) { failed = 1; exit 1 }
      }
    }
    END {
      if (!failed && NR % size) {
        print " }" | cmd
        if (close(cmd) != 0) exit 1
      }
    }
  '
}

discard_sets() {
  nft -f - <<NFT
destroy set $nft_table blocked$1
destroy set $nft_table blocked_cidrs$1
destroy set $nft_table allowed$1
NFT
}

reload() {
  local active next=_next legacy='' chain
  if active=$(active_suffix) && [[ -n $active ]]; then
    next=
  fi
  for chain in input forward; do
    if nft list chain inet nfban "$chain" >/dev/null 2>&1; then
      legacy+="flush chain $nft_table $chain"$'\n'"delete chain $nft_table $chain"$'\n'
    fi
  done
  nft -f - <<NFT
add table $nft_table
destroy set $nft_table blocked$next
destroy set $nft_table blocked_cidrs$next
destroy set $nft_table allowed$next
add set $nft_table blocked$next { type ipv4_addr; }
add set $nft_table blocked_cidrs$next { type ipv4_addr; flags interval; }
add set $nft_table allowed$next { type ipv4_addr; flags interval; }
NFT
  if ! read_hosts | load_batches "blocked$next" \
    || ! load_batches "blocked_cidrs$next" <"$cidrs" \
    || ! read_allow | load_batches "allowed$next"; then
    discard_sets "$next" || :
    die 'batch load failed; previous rules were left in place'
  fi
  # Rules and set references change in the same kernel transaction. Priority
  # raw drops banned packets before conntrack, so they create no state. The
  # allowlist accept ends only this chain; other tables still see the packet.
  if ! nft -f - <<NFT
add chain $nft_table prerouting { type filter hook prerouting priority raw; policy accept; }
flush chain $nft_table prerouting
add rule $nft_table prerouting ip saddr @allowed$next accept
add rule $nft_table prerouting ip saddr @blocked$next drop
add rule $nft_table prerouting ip saddr @blocked_cidrs$next drop
${legacy}destroy set $nft_table blocked$active
destroy set $nft_table blocked_cidrs$active
destroy set $nft_table allowed$active
NFT
  then
    discard_sets "$next" || :
    die 'could not switch sets; previous rules were left in place'
  fi
  success "Reloaded ${bold}$nft_table${reset}"
}

update_element() {
  local action=$1 set_name=$2 value=$3 error
  if [[ $action == add ]]; then
    nft add element inet nfban "$set_name" "{ $value }"
  elif ! error=$(nft destroy element inet nfban "$set_name" "{ $value }" 2>&1); then
    # nft may reject a missing exact element of an interval set before its
    # idempotent destroy reaches the kernel.
    if [[ ! ($set_name == blocked_cidrs* || $set_name == allowed*)
      || $error != 'Error: element does not exist'$'\n'* ]]; then
      printf '%s\n' "$error" >&2
      return 1
    fi
  fi
}

insert_ban() {
  awk -v address="$address" -v target="$network" -v prefix="$prefix" -v error="$awk_error" \
    "$ip_key"'
    BEGIN { target_end = target + 2^(32 - prefix) }
    !done {
      current = key($0)
      width = (split($0, fields, "/") == 2) ? 2^(32 - fields[2]) : 1
      if (current < target_end && target < current + width) {
        print error address " overlaps saved " $0 > "/dev/stderr"
        conflict = 1
        exit 1
      }
      if (!inserted && current > target) { print address; inserted = 1 }
      if (inserted && (prefix == 32 || current >= target_end)) done = 1
    }
    { print }
    END { if (!inserted && !conflict) print address }
  ' "$1"
}

# covering_entry FILE: prints the saved host or subnet in FILE containing the
# address or subnet, if any.
covering_entry() {
  awk -v target="$network" -v prefix="$prefix" "$ip_key"'
    BEGIN { target_end = target + 2^(32 - prefix) }
    { start = key($0); width = (split($0, fields, "/") == 2) ? 2^(32 - fields[2]) : 1 }
    start > target { exit }
    target_end <= start + width { print; exit }
  ' "$1"
}

# Prints the allowlist entry containing the address or subnet, if any.
allowed_by() {
  if [[ -e $allow ]]; then covering_entry "$allow"; fi
}

# warn_allowed ENTRY: warns that an allowlist entry overrides the new ban.
warn_allowed() {
  if [[ -n $1 ]]; then
    warn "$address is allowlisted by $1; the ban has no effect"
  fi
}

# Live rules loaded by versions without the allowlist lack its set until reload.
require_allowed_set() {
  nft -t list set inet nfban "allowed$1" >/dev/null 2>&1 \
    || die 'live rules have no allowlist' "${sudo_prefix}nfban reload"
}

# Counts entries on stdin, in numeric order, fully covered by an allowlist entry.
count_allowed() {
  awk -v allow="$allow" -v error="$awk_error" "$ip_key"'
    function range(entry,  fields) {
      first = key(entry)
      last = first + ((split(entry, fields, "/") == 2) ? 2^(32 - fields[2]) : 1)
    }
    function advance(  entry, r) {
      if ((r = (getline entry < allow)) < 0) {
        print error "cannot read " allow > "/dev/stderr"
        failed = 1
        exit 1
      }
      if (r) { range(entry); start = first; end = last }
      else start = end = 2^33
    }
    BEGIN { advance() }
    {
      range($0)
      while (end <= first) advance()
      if (start <= first && last <= end) covered++
    }
    END { if (failed) exit 1; print covered + 0 }
  '
}

# change_entry block|allow add|remove: changes one live element and its file.
change_entry() {
  local scope=$1 action=$2 file source active set_name saved covering allowed='' fixed=1
  active=$(active_suffix) || die 'no active ban rules' "${sudo_prefix}nfban reload"
  if [[ $scope == allow ]]; then
    require_allowed_set "$active"
    file=$allow
    set_name=allowed$active
  else
    if [[ $action == add ]]; then
      allowed=$(allowed_by)
    fi
    if [[ $action == add ]] && ((prefix == 32)); then
      covering=$(covering_entry "$cidrs")
      if [[ -n $covering ]]; then
        # Like any repeated add, this restores a missing live element.
        update_element add "blocked_cidrs$active" "$covering" \
          || die 'nftables update failed'
        success "Already banned by subnet $bold$covering$reset"
        warn_allowed "$allowed"
        return
      fi
    fi
    if ((prefix == 32)); then
      printf -v file '%s/%03d.%03d.txt' "$hosts" "$((network >> 24))" "$((network >> 16 & 255))"
      set_name=blocked$active
      # Emptied /16 files are deleted; the other files always exist.
      fixed=
    else
      file=$cidrs
      set_name=blocked_cidrs$active
    fi
  fi
  source=$file
  if [[ ! -e $source && ! -L $source ]]; then
    source=/dev/null
  else
    [[ -f $source && ! -L $source ]] || die "not a regular file: $source"
  fi
  if grep -Fxq -- "$address" "$source"; then
    saved=1
  else
    [[ $? == 1 ]] || die "cannot read $source"
    saved=0
  fi

  if [[ $action == add && $saved == 0 || $action == remove && $saved == 1 ]]; then
    temp=$(mktemp -- "$file.XXXXXX")
    chmod 644 -- "$temp"
    if [[ $action == add ]]; then
      insert_ban "$source" >"$temp"
    else
      awk -v address="$address" '$0 != address' "$source" >"$temp"
    fi
    if [[ $action == add || -n $fixed || -s $temp ]]; then
      sync -- "$temp"
    fi
  fi

  # Even a no-op on disk repairs a missing or extra live element.
  update_element "$action" "$set_name" "$address" \
    || die "nftables update failed; saved entries were not changed"
  if [[ -n $temp ]]; then
    if [[ $action == remove && -z $fixed && ! -s $temp ]]; then
      rm -f -- "$file" \
        || die 'live entry changed but saving failed; retry the command or run nfban reload'
      rm -f -- "$temp"
      temp=
    else
      mv -fT -- "$temp" "$file" \
        || die 'live entry changed but saving failed; retry the command or run nfban reload'
      temp=
    fi
    sync -- "${file%/*}"
  fi
  case $scope/$action/$saved in
    block/add/1) success "Already banned: $bold$address$reset" ;;
    block/add/0) success "Banned $bold$address$reset" ;;
    block/remove/1) success "Removed exact ban $bold$address$reset" ;;
    block/remove/0) success "No exact ban for $bold$address$reset" ;;
    allow/add/1) success "Already allowlisted: $bold$address$reset" ;;
    allow/add/0) success "Allowlisted $bold$address$reset" ;;
    allow/remove/1) success "Removed exact allowlist entry $bold$address$reset" ;;
    allow/remove/0) success "No exact allowlist entry for $bold$address$reset" ;;
  esac
  warn_allowed "$allowed"
}

sort_ips() {
  sort -t. -k1,1n -k2,2n -k3,3n -k4,4n "$@"
}

list_host_files() {
  local out=$1 f
  local files=("$hosts"/[0-9][0-9][0-9].[0-9][0-9][0-9].txt)
  : >"$out"
  for f in "${files[@]}"; do
    [[ -f $f && ! -L $f ]] || die "not a regular file: $f"
    printf '%s\n' "${f##*/}"
  done >"$out"
}

sync_files() {
  local dir=$1
  shift
  if (($# == 0)); then
    return
  elif (($# <= 64)); then
    sync -- "$@"
  else
    sync -f -- "$dir"
  fi
}

# Parses stdin into normalized hosts and CIDRs in one awk pass. With line
# numbers, every entry is followed by its input line. Both outputs may be the
# same file.
parse_batch_input() {
  local hosts_out=$1 cidrs_out=$2 with_lines=${3:-1}
  : >"$hosts_out"
  : >"$cidrs_out"
  awk -v hosts_out="$hosts_out" -v cidrs_out="$cidrs_out" -v with_lines="$with_lines" \
    -v err_bold="$err_bold" -v err_reset="$err_reset" '
    function bad(  raw) {
      raw = $0
      sub(/\r$/, "", raw)
      printf "%sline %d:%s invalid IPv4 address or CIDR: %s\n", err_bold, NR, err_reset, raw > "/dev/stderr"
      invalid++
    }
    {
      entry = $0
      sub(/#.*/, "", entry)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", entry)
      if (entry == "") next
      if (entry ~ /[[:space:]]/) { bad(); next }
      nparts = split(entry, parts, "/")
      if (nparts > 2) { bad(); next }
      if (nparts == 2) {
        if (parts[2] !~ /^[0-9]+$/ || length(parts[2]) > 2) { bad(); next }
        prefix = parts[2] + 0
        if (prefix < 1 || prefix > 32) { bad(); next }
      } else {
        prefix = 32
      }
      if (split(parts[1], oct, ".") != 4) { bad(); next }
      ip = 0
      ok = 1
      for (i = 1; i <= 4; i++) {
        if (oct[i] !~ /^[0-9]+$/ || length(oct[i]) > 3) { ok = 0; break }
        v = oct[i] + 0
        if (v > 255) { ok = 0; break }
        ip = ip * 256 + v
      }
      if (!ok) { bad(); next }
      if (prefix < 32) {
        width = 2^(32 - prefix)
        network = int(ip / width) * width
      } else {
        network = ip
      }
      d = network % 256; t = int(network / 256)
      c = t % 256; t = int(t / 256)
      b = t % 256; a = int(t / 256)
      entry = sprintf("%d.%d.%d.%d", a, b, c, d)
      if (prefix < 32) entry = entry "/" prefix
      if (with_lines) entry = entry " " NR
      if (prefix == 32) print entry > hosts_out
      else print entry > cidrs_out
    }
    END { print invalid + 0 }
  '
}

destroy_cidrs_live() {
  local set_name=$1 file=$2 error cidr
  [[ -s $file ]] || return 0
  if error=$(load_batches "$set_name" destroy <"$file" 2>&1); then
    return 0
  fi
  if [[ $error != *'Error: element does not exist'* ]]; then
    printf '%s\n' "$error" >&2
    return 1
  fi
  while IFS= read -r cidr; do
    update_element remove "$set_name" "$cidr" || return 1
  done <"$file"
}

# merge_entries SAVED INPUT MERGED LIVE: merges "entry line" input with the
# saved entries (line 0) in numeric order. Every entry goes to MERGED, listed
# ones to LIVE. Fails if two entries overlap; prints "added already".
merge_entries() {
  { awk '{ print $0, 0 }' "$1" && cat -- "$2"; } | sort_ips \
    | awk -v error="$awk_error" -v merged="$3" -v live="$4" "$ip_key"'
      function describe(entry, line) {
        return entry " (" (line ? "line " line : "saved") ")"
      }
      function finish(  fields, start) {
        if (addr == "") return
        start = key(addr)
        if (have && start < end) {
          print error describe(addr, line) " overlaps " describe(last, last_line) > "/dev/stderr"
          bad = 1
          return
        }
        have = 1
        end = start + ((split(addr, fields, "/") == 2) ? 2^(32 - fields[2]) : 1)
        last = addr
        last_line = line
        print addr > merged
        if (line) {
          print addr > live
          if (saved) already++
          else added++
        }
      }
      $1 != addr { finish(); addr = $1; line = 0; saved = 0 }
      $2 == 0 { saved = 1 }
      $2 != 0 && (!line || $2 < line) { line = $2 }
      END { finish(); print added + 0, already + 0; exit bad }
    '
}

# drop_exact SAVED REMOVE OUT: copies SAVED to OUT without the lines listed in
# REMOVE and prints how many were dropped. OUT is written only if any were.
drop_exact() {
  awk -v remove_file="$2" -v out="$3" '
    BEGIN {
      while ((getline c < remove_file) > 0) drop[c] = 1
      close(remove_file)
    }
    ($0 in drop) { removed++; next }
    { print > out }
    END {
      if (removed) printf "" > out
      print removed + 0
    }
  ' "$1"
}

# add --batch: checks every input line first, then applies the whole list with
# batched nft loads and one rewrite per touched file.
batch_add() {
  local active invalid stats subnets_added subnets_saved allowlisted=0
  local covered hosts_added hosts_live files to_sync=()
  active=$(active_suffix) || die 'no active ban rules' "${sudo_prefix}nfban reload"
  if [[ -t 0 ]]; then
    printf '%s\n' 'Paste addresses or subnets, one per line, then press Ctrl-D.' >&2
  fi
  # Inside $config so that saving is an atomic rename.
  temp=$(mktemp -d -- "$config/batch.XXXXXX")
  mkdir -- "$temp/hosts"
  : >"$temp/hosts.live"
  : >"$temp/cidrs.live"
  invalid=$(parse_batch_input "$temp/hosts.in" "$temp/cidrs.in" 1)
  ((invalid == 0)) || die "$invalid invalid line(s); nothing was added"
  [[ -s $temp/hosts.in || -s $temp/cidrs.in ]] || die 'no addresses in input'

  # Saved subnets carry line 0. In numeric order, every subnet must end before
  # the next one starts.
  stats=$(merge_entries "$cidrs" "$temp/cidrs.in" "$temp/cidrs.txt" "$temp/cidrs.live") \
    || die 'overlapping subnets; nothing was added'
  read -r subnets_added subnets_saved <<<"$stats"

  list_host_files "$temp/existing"

  # Hosts inside a saved or new subnet are skipped. The rest are merged with
  # their /16 files in one pass; only files that gain hosts are rewritten.
  stats=$(
    sort_ips -u -- "$temp/hosts.in" \
      | awk -v cidrs="$temp/cidrs.txt" -v saved="$hosts" -v existing="$temp/existing" \
        -v dir="$temp/hosts" -v live="$temp/hosts.live" -v error="$awk_error" "$ip_key"'
        function advance(  subnet, fields) {
          if ((getline subnet < cidrs) > 0) {
            split(subnet, fields, "/")
            start = key(subnet)
            end = start + 2^(32 - fields[2])
          } else {
            start = end = 2^33
          }
        }
        function flush(  target, line, r, value, count, i, j, merged) {
          if (group == "") return
          target = saved "/" group
          i = 1
          if (group in exists) {
            while ((r = (getline line < target)) > 0) {
              value = key(line)
              while (i <= n && keys[i] < value) { merged[++j] = new[i++]; count++ }
              if (i <= n && keys[i] == value) i++
              merged[++j] = line
            }
            close(target)
            if (r < 0) {
              print error "cannot read " target > "/dev/stderr"
              failed = 1
              exit 1
            }
          }
          while (i <= n) { merged[++j] = new[i++]; count++ }
          if (count) {
            for (i = 1; i <= j; i++) print merged[i] > (dir "/" group)
            close(dir "/" group)
            added += count
          }
          n = 0
        }
        BEGIN {
          while ((getline name < existing) > 0) exists[name] = 1
          close(existing)
          advance()
        }
        {
          value = key($1)
          while (value >= end) advance()
          if (value >= start) { covered++; next }
          split($1, octets, ".")
          name = sprintf("%03d.%03d.txt", octets[1], octets[2])
          if (name != group) { flush(); group = name }
          new[++n] = $1
          keys[n] = value
          print $1 > live
        }
        END { if (!failed) { flush(); print covered + 0, added + 0 } }
      '
  ) || die 'failed to merge host bans; nothing was added'
  read -r covered hosts_added <<<"$stats"
  hosts_live=$(wc -l <"$temp/hosts.live")
  if [[ -s $allow ]]; then
    allowlisted=$(sort_ips -- "$temp/hosts.live" "$temp/cidrs.live" | count_allowed) \
      || die 'cannot read the allowlist; nothing was added'
  fi

  if ! load_batches "blocked$active" <"$temp/hosts.live" \
    || ! load_batches "blocked_cidrs$active" <"$temp/cidrs.live"; then
    die 'nftables update failed; saved bans were not changed' "${sudo_prefix}nfban reload"
  fi
  files=("$temp"/hosts/*.txt)
  to_sync=("${files[@]}")
  if ((subnets_added)); then
    to_sync+=("$temp/cidrs.txt")
  fi
  sync_files "$temp" "${to_sync[@]}"
  if ((${#files[@]})); then
    printf '%s\0' "${files[@]}" | xargs -0 mv -f -t "$hosts" -- \
      || die 'live bans changed but saving failed; retry the command'
  fi
  if ((subnets_added)); then
    mv -fT -- "$temp/cidrs.txt" "$cidrs" \
      || die 'live bans changed but saving failed; retry the command'
  fi
  sync -- "$hosts" "$config"

  success 'Batch applied'
  printf '  %-20s %s\n' 'New hosts' "$hosts_added" 'New subnets' "$subnets_added" \
    'Already banned' "$((hosts_live - hosts_added + subnets_saved))" \
    'Covered by subnets' "$covered"
  if ((allowlisted)); then
    warn "$allowlisted listed ban(s) are allowlisted and have no effect"
  fi
}

# remove --batch: checks every input line first, then removes exact matches
# from live sets and updates or deletes only the touched files.
batch_remove() {
  local active invalid stats subnets_removed hosts_removed
  local hosts_live cidrs_live files to_sync=() delete_list=() name
  active=$(active_suffix) || die 'no active ban rules' "${sudo_prefix}nfban reload"
  if [[ -t 0 ]]; then
    printf '%s\n' 'Paste addresses or subnets to remove, one per line, then press Ctrl-D.' >&2
  fi
  temp=$(mktemp -d -- "$config/batch.XXXXXX")
  mkdir -- "$temp/hosts"
  : >"$temp/hosts.live"
  : >"$temp/cidrs.live"
  : >"$temp/hosts.delete"
  invalid=$(parse_batch_input "$temp/hosts.in" "$temp/cidrs.in" 0)
  ((invalid == 0)) || die "$invalid invalid line(s); nothing was removed"
  [[ -s $temp/hosts.in || -s $temp/cidrs.in ]] || die 'no addresses in input'

  sort_ips -u -- "$temp/hosts.in" >"$temp/hosts.live"
  sort_ips -u -- "$temp/cidrs.in" >"$temp/cidrs.live"
  hosts_live=$(wc -l <"$temp/hosts.live")
  cidrs_live=$(wc -l <"$temp/cidrs.live")

  subnets_removed=0
  if ((cidrs_live)); then
    subnets_removed=$(drop_exact "$cidrs" "$temp/cidrs.live" "$temp/cidrs.txt")
  fi

  list_host_files "$temp/existing"

  hosts_removed=0
  if ((hosts_live)); then
    hosts_removed=$(
      awk -v saved="$hosts" -v existing="$temp/existing" -v dir="$temp/hosts" \
        -v del="$temp/hosts.delete" -v error="$awk_error" "$ip_key"'
        function flush(  target, line, r, value, count, i, j, kept) {
          if (group == "") return
          if (!(group in exists)) { n = 0; return }
          target = saved "/" group
          i = 1
          while ((r = (getline line < target)) > 0) {
            value = key(line)
            while (i <= n && keys[i] < value) i++
            if (i <= n && keys[i] == value) {
              count++
              i++
              continue
            }
            kept[++j] = line
          }
          close(target)
          if (r < 0) {
            print error "cannot read " target > "/dev/stderr"
            failed = 1
            exit 1
          }
          if (count) {
            if (j) {
              for (i = 1; i <= j; i++) print kept[i] > (dir "/" group)
              close(dir "/" group)
            } else {
              print group > del
            }
            removed += count
          }
          n = 0
        }
        BEGIN {
          while ((getline name < existing) > 0) exists[name] = 1
          close(existing)
        }
        {
          split($1, octets, ".")
          name = sprintf("%03d.%03d.txt", octets[1], octets[2])
          if (name != group) { flush(); group = name }
          keys[++n] = key($1)
        }
        END { if (!failed) { flush(); print removed + 0 } }
      ' "$temp/hosts.live"
    ) || die 'failed to update host bans; nothing was removed'
  fi

  if ! load_batches "blocked$active" destroy <"$temp/hosts.live" \
    || ! destroy_cidrs_live "blocked_cidrs$active" "$temp/cidrs.live"; then
    die 'nftables update failed; saved bans were not changed' "${sudo_prefix}nfban reload"
  fi

  files=("$temp"/hosts/*.txt)
  to_sync=("${files[@]}")
  if ((subnets_removed)); then
    to_sync+=("$temp/cidrs.txt")
  fi
  sync_files "$temp" "${to_sync[@]}"
  if ((${#files[@]})); then
    printf '%s\0' "${files[@]}" | xargs -0 mv -f -t "$hosts" -- \
      || die 'live bans changed but saving failed; retry the command'
  fi
  if [[ -s $temp/hosts.delete ]]; then
    while IFS= read -r name; do
      delete_list+=("$hosts/$name")
    done <"$temp/hosts.delete"
    printf '%s\0' "${delete_list[@]}" | xargs -0 rm -f -- \
      || die 'live bans changed but saving failed; retry the command'
  fi
  if ((subnets_removed)); then
    mv -fT -- "$temp/cidrs.txt" "$cidrs" \
      || die 'live bans changed but saving failed; retry the command'
  fi
  sync -- "$hosts" "$config"

  success 'Batch applied'
  printf '  %-20s %s\n' 'Removed hosts' "$hosts_removed" 'Removed subnets' "$subnets_removed" \
    'Not saved' "$((hosts_live - hosts_removed + cidrs_live - subnets_removed))"
}

# remove --dedupe: removes saved hosts covered by a saved subnet from the live
# set and rewrites or deletes only the touched /16 files. The covering subnets
# are restored in the live set first, so the hosts never become unbanned.
dedupe_hosts() {
  local active removed files delete_list=() name
  active=$(active_suffix) || die 'no active ban rules' "${sudo_prefix}nfban reload"
  temp=$(mktemp -d -- "$config/batch.XXXXXX")
  mkdir -- "$temp/hosts"
  : >"$temp/hosts.live"
  : >"$temp/cidrs.live"
  : >"$temp/hosts.delete"
  list_host_files "$temp/existing"

  # Host files and subnets are both in numeric order, so one merge pass finds
  # every covered host; it stops once the subnets run out.
  removed=$(
    awk -v cidrs="$cidrs" -v saved="$hosts" -v existing="$temp/existing" \
      -v dir="$temp/hosts" -v live="$temp/hosts.live" -v cidrs_live="$temp/cidrs.live" \
      -v del="$temp/hosts.delete" -v error="$awk_error" "$ip_key"'
      function fail(path) {
        print error "cannot read " path > "/dev/stderr"
        exit 1
      }
      function advance(  subnet, fields, r) {
        if ((r = (getline subnet < cidrs)) < 0) fail(cidrs)
        if (r) {
          current = subnet
          split(subnet, fields, "/")
          start = key(subnet)
          end = start + 2^(32 - fields[2])
        } else {
          start = end = 2^33
        }
      }
      BEGIN {
        advance()
        while (start < 2^33 && (getline group < existing) > 0) {
          target = saved "/" group
          count = j = 0
          while ((r = (getline line < target)) > 0) {
            value = key(line)
            while (value >= end) advance()
            if (value >= start) {
              print line > live
              count++
              if (current != covering) { print current > cidrs_live; covering = current }
            } else kept[++j] = line
          }
          close(target)
          if (r < 0) fail(target)
          if (!count) continue
          if (j) {
            for (i = 1; i <= j; i++) print kept[i] > (dir "/" group)
            close(dir "/" group)
          } else {
            print group > del
          }
          removed += count
        }
        print removed + 0
      }
    '
  ) || die 'failed to read saved bans; nothing was removed'
  if ((removed == 0)); then
    success 'No hosts covered by subnets'
    return
  fi

  if ! load_batches "blocked_cidrs$active" <"$temp/cidrs.live" \
    || ! load_batches "blocked$active" destroy <"$temp/hosts.live"; then
    die 'nftables update failed; saved bans were not changed' "${sudo_prefix}nfban reload"
  fi
  files=("$temp"/hosts/*.txt)
  sync_files "$temp" "${files[@]}"
  if ((${#files[@]})); then
    printf '%s\0' "${files[@]}" | xargs -0 mv -f -t "$hosts" -- \
      || die 'live bans changed but saving failed; retry the command'
  fi
  if [[ -s $temp/hosts.delete ]]; then
    while IFS= read -r name; do
      delete_list+=("$hosts/$name")
    done <"$temp/hosts.delete"
    printf '%s\0' "${delete_list[@]}" | xargs -0 rm -f -- \
      || die 'live bans changed but saving failed; retry the command'
  fi
  sync -- "$hosts"
  success "Removed $bold$removed$reset host(s) covered by subnets"
}

# allow add --batch: checks every input line first, then loads the entries live
# and rewrites the allowlist once.
batch_allow_add() {
  local active invalid stats added already source=$allow
  active=$(active_suffix) || die 'no active ban rules' "${sudo_prefix}nfban reload"
  require_allowed_set "$active"
  [[ -e $source ]] || source=/dev/null
  if [[ -t 0 ]]; then
    printf '%s\n' 'Paste addresses or subnets, one per line, then press Ctrl-D.' >&2
  fi
  temp=$(mktemp -d -- "$config/batch.XXXXXX")
  : >"$temp/allow.live"
  invalid=$(parse_batch_input "$temp/in" "$temp/in" 1)
  ((invalid == 0)) || die "$invalid invalid line(s); nothing was added"
  [[ -s $temp/in ]] || die 'no addresses in input'
  stats=$(merge_entries "$source" "$temp/in" "$temp/allow.txt" "$temp/allow.live") \
    || die 'overlapping entries; nothing was added'
  read -r added already <<<"$stats"

  load_batches "allowed$active" <"$temp/allow.live" \
    || die 'nftables update failed; saved allowlist was not changed' "${sudo_prefix}nfban reload"
  if ((added)); then
    sync -- "$temp/allow.txt"
    mv -fT -- "$temp/allow.txt" "$allow" \
      || die 'live allowlist changed but saving failed; retry the command'
    sync -- "$config"
  fi
  success 'Batch applied'
  printf '  %-20s %s\n' 'New entries' "$added" 'Already allowlisted' "$already"
}

# allow remove --batch: removes exact entries live, then rewrites the allowlist.
batch_allow_remove() {
  local active invalid listed removed=0
  active=$(active_suffix) || die 'no active ban rules' "${sudo_prefix}nfban reload"
  require_allowed_set "$active"
  if [[ -t 0 ]]; then
    printf '%s\n' 'Paste addresses or subnets to remove, one per line, then press Ctrl-D.' >&2
  fi
  temp=$(mktemp -d -- "$config/batch.XXXXXX")
  invalid=$(parse_batch_input "$temp/in" "$temp/in" 0)
  ((invalid == 0)) || die "$invalid invalid line(s); nothing was removed"
  [[ -s $temp/in ]] || die 'no addresses in input'
  # A host and a subnet starting at the same address have equal sort keys and
  # fall back to whole-line order, so uniq still sees every duplicate.
  sort_ips -- "$temp/in" | uniq >"$temp/allow.live"
  listed=$(wc -l <"$temp/allow.live")
  if [[ -e $allow ]]; then
    removed=$(drop_exact "$allow" "$temp/allow.live" "$temp/allow.txt")
  fi

  destroy_cidrs_live "allowed$active" "$temp/allow.live" \
    || die 'nftables update failed; saved allowlist was not changed' "${sudo_prefix}nfban reload"
  if ((removed)); then
    sync -- "$temp/allow.txt"
    mv -fT -- "$temp/allow.txt" "$allow" \
      || die 'live allowlist changed but saving failed; retry the command'
    sync -- "$config"
  fi
  success 'Batch applied'
  printf '  %-20s %s\n' 'Removed entries' "$removed" 'Not saved' "$((listed - removed))"
}

check_ban() {
  local file ban_match='' ban_entry='' allow_match='' allow_entry='' blocked=no
  if ((prefix == 32)); then
    printf -v file '%s/%03d.%03d.txt' "$hosts" "$((network >> 24))" "$((network >> 16 & 255))"
  else
    file=$cidrs
  fi
  if [[ -f $file && ! -L $file ]] && grep -Fxq -- "$address" "$file"; then
    ban_match=exact
    ban_entry=$address
  else
    ban_entry=$(covering_entry "$cidrs")
    if [[ -n $ban_entry ]]; then ban_match=subnet; fi
  fi
  allow_entry=$(allowed_by)
  if [[ $allow_entry == "$address" ]]; then
    allow_match=exact
  elif [[ -n $allow_entry ]]; then
    allow_match=subnet
  fi
  if [[ -n $ban_match && -z $allow_match ]]; then blocked=yes; fi

  if [[ ! -t 1 ]]; then
    printf 'blocked=%s\n' "$blocked"
    if [[ -n $ban_match ]]; then
      printf 'banned=yes\nban_match=%s\nban_entry=%s\n' "$ban_match" "$ban_entry"
    else
      printf 'banned=no\n'
    fi
    if [[ -n $allow_match ]]; then
      printf 'allowed=yes\nallow_match=%s\nallow_entry=%s\n' "$allow_match" "$allow_entry"
    else
      printf 'allowed=no\n'
    fi
  else
    if [[ $blocked == yes ]]; then
      success "Blocked: $bold$address$reset"
    else
      printf '%s%s%s Not blocked: %s%s%s\n' "$red" "$sym_fail" "$reset" "$bold" "$address" "$reset"
    fi
    printf '  %-10s %s\n' 'Ban' "${ban_entry:-none}${ban_match:+ ($ban_match)}" \
      'Allowlist' "${allow_entry:-none}${allow_match:+ ($allow_match)}"
  fi
  [[ $blocked == yes ]]
}

print_status() {
  local state=$4 color symbol label
  if [[ ! -t 1 ]]; then
    printf 'banned_hosts=%d\nbanned_subnets=%d\nallowlisted=%d\nactive=%s\n' "$1" "$2" "$3" "$state"
    return
  fi
  case $state in
    available) color=$green symbol=$sym_dot label='active' ;;
    *) color=$red symbol=$sym_fail label='unavailable' ;;
  esac
  printf '  %-16s %s\n' 'Banned hosts' "$1" 'Banned subnets' "$2" 'Allowlisted' "$3"
  printf '  %-16s %s%s %s%s\n' 'Live rules' "$color" "$symbol" "$label" "$reset"
  if [[ $state == unavailable ]]; then
    printf '\n'
    hint 'Run:' "${sudo_prefix}nfban reload"
  fi
}

status() {
  local host_count cidr_count allow_count active state=available
  host_count=$(read_hosts | wc -l)
  cidr_count=$(wc -l <"$cidrs")
  allow_count=$(read_allow | wc -l)
  if ! active=$(active_suffix 2>/dev/null) \
    || ! nft -t list set inet nfban "blocked$active" >/dev/null 2>&1 \
    || ! nft -t list set inet nfban "blocked_cidrs$active" >/dev/null 2>&1 \
    || ! nft -t list set inet nfban "allowed$active" >/dev/null 2>&1; then
    state=unavailable
  fi
  print_status "$host_count" "$cidr_count" "$allow_count" "$state"
  [[ $state == available ]]
}

self_update() {
  local script dir first_line=''
  script=$(realpath -- "${BASH_SOURCE[0]}")
  [[ -f $script ]] || die "cannot locate installed script: $script"
  check_script_owner "$script"

  dir=${script%/*}
  dir=${dir:-/}
  temp=$(mktemp -- "$dir/.nfban.XXXXXX")
  if command -v curl >/dev/null; then
    curl -fsSL "$update_url" -o "$temp" || die "failed to download $update_url"
  elif command -v wget >/dev/null; then
    wget -qO "$temp" "$update_url" || die "failed to download $update_url"
  else
    die 'missing required command: curl or wget'
  fi

  IFS= read -r first_line <"$temp" || :
  if [[ ! -s $temp || $first_line != '#!/usr/bin/env bash' ]] || ! bash -n -- "$temp" 2>/dev/null; then
    die 'downloaded file is not a valid nfban script'
  fi

  if cmp -s -- "$temp" "$script"; then
    rm -f -- "$temp"
    temp=
    success 'Already up to date'
    return
  fi

  chmod 755 -- "$temp"
  sync -- "$temp"
  mv -fT -- "$temp" "$script" || die "could not replace $script"
  temp=
  sync -- "$dir"
  success "Updated ${bold}$script${reset}"
  if [[ -f $unit ]]; then
    hint 'To apply unit or rule changes:' "${sudo_prefix}nfban init && ${sudo_prefix}nfban reload"
  fi
}

main() {
  local command=${1-} action='' address prefix network run batch='' dedupe='' read_only=''
  # Frame terminal output with blank lines; cleanup closes the frame.
  if [[ -t 1 ]]; then
    printf '\n'
    framed=1
  fi
  case $command in
    '' | -h | --help)
      usage
      return
      ;;
    init | reload | block | allow | check | status | self-update) ;;
    *) die "unknown command: $command" 'nfban --help' ;;
  esac
  shift
  case ${1-} in
    -h | --help)
      usage "$command"
      return
      ;;
  esac
  if [[ $command == block || $command == allow ]]; then
    action=${1-}
    case $action in
      rm) action=remove ;;
      add | remove | list) ;;
      '') die "nfban $command needs add, remove or list" "nfban $command --help" ;;
      *) die "unknown subcommand: $command $action" "nfban $command --help" ;;
    esac
    shift
    case ${1-} in
      -h | --help)
        usage "$command"
        return
        ;;
    esac
  fi
  case $command/$action in
    block/add | block/remove | allow/add | allow/remove)
      if (($# == 1)) && [[ $1 == --batch ]]; then
        batch=1
      elif (($# == 1)) && [[ $command/$action == block/remove && $1 == --dedupe ]]; then
        dedupe=1
      else
        (($# == 1)) \
          || die 'expected one IPv4 address or CIDR' "${sudo_prefix}nfban $command $action 192.0.2.10"
        parse_address "$1" \
          || die "invalid IPv4 address or CIDR: $1" "${sudo_prefix}nfban $command $action 192.0.2.10"
      fi
      ;;
    check/)
      (($# == 1)) \
        || die 'expected one IPv4 address or CIDR' 'nfban check 192.0.2.10'
      parse_address "$1" \
        || die "invalid IPv4 address or CIDR: $1" 'nfban check 192.0.2.10'
      ;;
    *)
      (($# == 0)) || die "nfban $command${action:+ $action} takes no arguments" \
        "${sudo_prefix}nfban $command${action:+ $action}"
      ;;
  esac
  if [[ $command == check || $action == list ]]; then read_only=1; fi

  if ((EUID != 0)) && [[ -z $read_only ]]; then
    if [[ -n $sudo_prefix ]]; then
      printf -v run '%q ' nfban "$command" ${action:+"$action"} "$@"
      die 'must run as root' "${sudo_prefix}${run% }"
    fi
    die 'must run as root'
  fi
  if [[ $command == self-update ]]; then
    self_update
    return
  fi
  if [[ $command == init ]]; then install_packages; fi
  require flock
  if [[ -z $read_only ]]; then require nft; fi
  if [[ $command == init ]]; then
    init
    return
  fi
  if [[ -e $config && ! (-r $config && -x $config) ]]; then
    die "cannot read $config" "${sudo_prefix}nfban init"
  fi
  [[ -f $unit && -d $hosts && -f $cidrs ]] \
    || die 'nfban is not initialized' "${sudo_prefix}nfban init"
  if [[ -n $read_only || $command == status ]]; then
    lock shared
  else
    lock
  fi
  case $command/$action in
    block/add)
      if [[ -n $batch ]]; then batch_add; else change_entry block add; fi
      ;;
    block/remove)
      if [[ -n $batch ]]; then
        batch_remove
      elif [[ -n $dedupe ]]; then
        dedupe_hosts
      else
        change_entry block remove
      fi
      ;;
    block/list) list_bans ;;
    allow/add)
      if [[ -n $batch ]]; then batch_allow_add; else change_entry allow add; fi
      ;;
    allow/remove)
      if [[ -n $batch ]]; then batch_allow_remove; else change_entry allow remove; fi
      ;;
    allow/list) read_allow ;;
    check/) check_ban ;;
    reload/) reload ;;
    status/) status ;;
  esac
}

main "$@"
